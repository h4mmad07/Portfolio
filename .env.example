# Browser-visible Supabase values. The anon/publishable key is expected to be public;
# protect data with RLS policies and never put a service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only values. Configure these only in a local ignored env file and deployment settings.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
OTP_HMAC_SECRET=generate-at-least-32-random-characters
RATE_LIMIT_HMAC_SECRET=generate-a-different-32-character-random-secret
RESEND_API_KEY=server-only-resend-api-key
RESEND_FROM_EMAIL=Portfolio <no-reply@your-verified-domain.example>
GITHUB_WEBHOOK_SECRET=generate-at-least-32-random-characters
